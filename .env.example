# ----------------------------------------------------------------
# UR-IM Backend Environment Configuration Template
# 复制此文件并命名为 .env，然后填入真实配置
# ----------------------------------------------------------------

# 1. 基础配置 (App Settings)
APP_NAME=UR-IM-Backend
DEBUG=True
PORT=8000

# 2. 数据库配置 (PostgreSQL)
# 格式: postgresql://用户:密码@主机:端口/数据库名
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/im_db

# 3. 安全与鉴权 (Security & JWT)
# 生产环境务必更换！可以使用 `openssl rand -hex 32` 生成
JWT_SECRET_KEY=your-super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 4. 邮件服务配置 (SMTP)
# 如果做邮件系统还没写好，先留空
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com